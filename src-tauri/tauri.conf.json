{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KitChat",
  "version": "0.1.0",
  "identifier": "com.kitchat.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KitChat",
        "width": 1100,
        "height": 760,
        "minWidth": 380,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Derek Leeth",
    "copyright": "Copyright (c) 2026 Derek Leeth. All rights reserved.",
    "shortDescription": "Family messenger with notes and lists",
    "android": {
      "minSdkVersion": 28
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
